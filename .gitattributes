# Normalise line endings in the repository; Windows tools get CRLF.
* text=auto

*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.props   text eol=crlf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.manifest text eol=crlf
*.md      text eol=crlf
*.json    text eol=crlf

*.ico     binary
*.png     binary
*.exe     binary
*.msi     binary
